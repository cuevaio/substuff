# AI SDK + Vercel AI Gateway. Optional; excerpts work without these.
AI_GATEWAY_API_KEY=
AI_MODEL=google/gemini-2.5-flash-lite
AI_FALLBACK_MODEL=openai/gpt-4.1-mini
RATE_LIMIT_SALT=
